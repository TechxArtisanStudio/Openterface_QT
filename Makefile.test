clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile.test


####### Sub-libraries

mocclean: compiler_moc_header_clean compiler_moc_objc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_objc_header_make_all compiler_moc_source_make_all

check: first

benchmark: first

compiler_rcc_make_all: rcc/qrc_mainwindow.cpp rcc/qrc_keyboard_layouts.cpp rcc/qrc_language.cpp rcc/qrc_customkeys.cpp rcc/qrc_drivers.cpp
compiler_rcc_clean:
	-$(DEL_FILE) rcc/qrc_mainwindow.cpp rcc/qrc_keyboard_layouts.cpp rcc/qrc_language.cpp rcc/qrc_customkeys.cpp rcc/qrc_drivers.cpp
rcc/qrc_mainwindow.cpp: ui/mainwindow.qrc \
		/usr/lib64/qt6/libexec/rcc \
		images/H1T0V1.svg \
		images/icon_256.png \
		images/H1T0V0.svg \
		images/screen_scale.svg \
		images/zoom_fit.svg \
		images/keyboard-up.svg \
		images/keyboard.svg \
		images/screensaver.svg \
		images/mouse-left-button.svg \
		images/H1T1V0.svg \
		images/audio.svg \
		images/capture.svg \
		images/H1T1V1.svg \
		images/H0T1V1.svg \
		images/mouse-right-button.svg \
