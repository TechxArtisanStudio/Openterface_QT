#!/bin/bash
# =============================================================================
# OpenterfaceQT Pre-Installation Script
# =============================================================================
#
# This script runs BEFORE the DEB package is unpacked and installed.
# It checks that all required runtime dependencies are already installed.
#
# IMPORTANT: Dependencies must be installed BEFORE running this script.
# When using "dpkg -i", the dpkg lock prevents apt-get from running in preinst.
# Dependencies must be pre-installed by the calling script/installer.
#
# =============================================================================

# Exit on non-install/upgrade
if [ "$1" != "install" ] && [ "$1" != "upgrade" ]; then
    exit 0
fi

echo "=========================================="
echo "OpenterfaceQT Pre-Installation Check"
echo "=========================================="
echo ""

# -----------------------------------------------------------------------------
# Dependency definitions
# Format: "library_file|package_name|description|required"
# library_file: The .so file to check with ldconfig
# package_name: The Debian package name (for install instructions)
# required: "yes" = hard dependency, "no" = optional (feature degradation only)
# -----------------------------------------------------------------------------
DEPENDENCIES=(
    # Graphics
    "libEGL.so.1|libegl1|EGL graphics library for hardware acceleration|yes"
    "libGLESv2.so.2|libgles2|OpenGL ES 2.0 for rendering|yes"
    
    # Audio
    "libpulse.so.0|libpulse0|PulseAudio for sound output|yes"
    
    # Video capture
    "libv4l2.so.0|libv4l-0|Video4Linux for camera/capture device support|yes"
    
    # Display server
    "libxkbcommon.so.0|libxkbcommon0|Keyboard handling library|yes"
    "libwayland-client.so.0|libwayland-client0|Wayland display server support|yes"
    "libxcb.so.1|libxcb1|X11 C Binding (core)|yes"
    "libxcb-shm.so.0|libxcb-shm0|X11 shared memory extension|yes"
    "libxcb-xfixes.so.0|libxcb-xfixes0|X11 region fixing extension|yes"
    "libX11.so.6|libx11-6|X11 core library|yes"
    
    # OpenGL
    "libGL.so.1|libgl1|OpenGL rendering|yes"
    "libGLX.so.0|libglx0|GLX extension for X11|yes"
    "libGLdispatch.so.0|libglvnd0|OpenGL vendor-neutral dispatch|yes"
    
    # Qt6 platform plugins
    "libxcb-icccm.so.4|libxcb-icccm4|Qt6 XCB ICCCM support|yes"
    "libxcb-image.so.0|libxcb-image0|Qt6 XCB image support|yes"
    "libxcb-keysyms.so.1|libxcb-keysyms1|Qt6 XCB keyboard symbols|yes"
    "libxcb-randr.so.0|libxcb-randr0|Qt6 XCB screen resize/rotate|yes"
    "libxcb-render-util.so.0|libxcb-render-util0|Qt6 XCB render utilities|yes"
    "libxcb-xkb.so.1|libxcb-xkb1|Qt6 XCB XKB keyboard support|yes"
    
    # Hardware acceleration (optional)
    "libva.so.2|libva2|VA-API for video decode acceleration|no"
    "libva-drm.so.2|libva-drm2|VA-API DRM support|no"
    "libva-x11.so.2|libva-x11-2|VA-API X11 support|no"
    "libvdpau.so.1|libvdpau1|VDPAU for video decode acceleration|no"
    
    # Hard dependency (application links against it)
    "libturbojpeg.so.0|libturbojpeg0|JPEG compression for video capture|yes"
    
    # Compression
    "libz.so.1|zlib1g|Compression library|yes"
    "libbz2.so.1.0|libbz2-1.0|Bzip2 compression support|yes"
    
    # Debug
    "libdw.so.1|libdw1|Debug information library|yes"
)

# -----------------------------------------------------------------------------
# Check functions
# -----------------------------------------------------------------------------
check_library() {
    local lib="$1"
    # Check if library is in ldconfig cache
    ldconfig -p 2>/dev/null | grep -q "lib[^ ]*${lib}"
}

# -----------------------------------------------------------------------------
# Main check logic
# -----------------------------------------------------------------------------
MISSING_REQUIRED=()
MISSING_OPTIONAL=()
FOUND_COUNT=0
TOTAL_COUNT=${#DEPENDENCIES[@]}

echo "Checking system dependencies..."
echo ""

for entry in "${DEPENDENCIES[@]}"; do
    IFS='|' read -r lib pkg desc required <<< "$entry"
    
    if check_library "$lib"; then
        FOUND_COUNT=$((FOUND_COUNT + 1))
    else
        if [ "$required" = "yes" ]; then
            MISSING_REQUIRED+=("$pkg|$desc")
        else
            MISSING_OPTIONAL+=("$pkg|$desc")
        fi
    fi
done

# -----------------------------------------------------------------------------
# Results
# -----------------------------------------------------------------------------
if [ ${#MISSING_REQUIRED[@]} -eq 0 ] && [ ${#MISSING_OPTIONAL[@]} -eq 0 ]; then
    echo "✅ All dependencies are installed."
    echo ""
    echo "Proceeding with OpenterfaceQT installation..."
    echo ""
    exit 0
fi

# We have missing dependencies - show details
echo "❌ Some dependencies are missing."
echo ""

if [ ${#MISSING_REQUIRED[@]} -gt 0 ]; then
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Required dependencies (${#MISSING_REQUIRED[@]} missing):"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    for entry in "${MISSING_REQUIRED[@]}"; do
        IFS='|' read -r pkg desc <<< "$entry"
        echo "  ❌ $pkg"
        echo "     └─ $desc"
        echo ""
    done
fi

if [ ${#MISSING_OPTIONAL[@]} -gt 0 ]; then
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Optional dependencies (${#MISSING_OPTIONAL[@]} missing):"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    for entry in "${MISSING_OPTIONAL[@]}"; do
        IFS='|' read -r pkg desc <<< "$entry"
        echo "  ⚠️  $pkg"
        echo "     └─ $desc (optional - some features may not work)"
        echo ""
    done
fi

# -----------------------------------------------------------------------------
# Fix instructions
# -----------------------------------------------------------------------------
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "How to fix"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Build package lists
REQUIRED_PKGS=()
for entry in "${MISSING_REQUIRED[@]}"; do
    IFS='|' read -r pkg desc <<< "$entry"
    REQUIRED_PKGS+=("$pkg")
done

OPTIONAL_PKGS=()
for entry in "${MISSING_OPTIONAL[@]}"; do
    IFS='|' read -r pkg desc <<< "$entry"
    OPTIONAL_PKGS+=("$pkg")
done

if [ ${#REQUIRED_PKGS[@]} -gt 0 ]; then
    echo "1. Install required dependencies:"
    echo ""
    echo "   sudo apt-get update"
    echo "   sudo apt-get install -y ${REQUIRED_PKGS[*]}"
    echo ""
fi

if [ ${#OPTIONAL_PKGS[@]} -gt 0 ]; then
    echo "2. (Optional) Install optional dependencies for full features:"
    echo ""
    echo "   sudo apt-get install -y ${OPTIONAL_PKGS[*]}"
    echo ""
fi

echo "3. Then retry installing OpenterfaceQT:"
echo ""
echo "   sudo dpkg -i openterfaceQT_linux_amd64.deb"
echo ""

if [ ${#REQUIRED_PKGS[@]} -gt 0 ]; then
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Installation blocked: required dependencies are missing."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    exit 1
else
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Proceeding with installation (optional dependencies missing)."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    exit 0
fi
